{
  "manifest_version": 3,
  "name": "Ghost Form",
  "version": "3.0.0",
  "description": "Privacy-first anti-phishing extension with on-device machine learning for zero-day detection.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": [
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "css": ["content.css"],
      "js": ["dist/content_features.js", "content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ghost Form",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html",
        "dist/offscreen.js",
        "dist/content_features.js",
        "dist/ml_worker.js",
        "dist/*.wasm",
        "dist/*.ort",
        "models/*",
        "auth.html",
        "auth.css",
        "auth.js",
        "dashboard.html",
        "dashboard.js",
        "analysis.html",
        "analysis.js",
        "report.html",
        "report.js",
        "popup.css",
        "options.html",
        "options.css",
        "options.js",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; connect-src 'self' https://*.supabase.co https://huggingface.co https://cdn-lfs.huggingface.co https://checkout.stripe.com https://app.simplelogin.io; img-src 'self' data:; style-src 'self' 'unsafe-inline'; default-src 'none'"
  }
}

